		sourceColumn: [Day Name]

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				VAR MinDate = DATE(YEAR(MIN(Fact_Orders[order_purchase_timestamp])), 1, 1)
				VAR MaxDate = DATE(YEAR(MAX(Fact_Orders[order_purchase_timestamp])), 12, 31)
				RETURN
				ADDCOLUMNS (
				    CALENDAR (MinDate, MaxDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMM"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day of Week", WEEKDAY([Date], 2),
				    "Day Name", FORMAT([Date], "DDD")
				)

	annotation PBI_Id = e5661112e164459a8456bcb449392df4

